# ============================================================================
# Cult of the Digital Oracle — Agent backend (3 AI orchestrator)
# ============================================================================
# Copy to `.env` and fill the placeholders. All three LLM endpoints expect
# OpenRouter-compatible keys; the SAME key works for all three slots, but they
# are separated so you can:
#   - use different OpenRouter accounts/keys per agent (e.g. for usage tracking)
#   - swap models per role without touching code
# If any *_API_KEY is empty, the agent falls back to OPENROUTER_API_KEY.
# ============================================================================

# ----- Chain / wallets -----
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
ORACLE_PRIVATE_KEY=
ORACLE_MESSAGE_ADDRESS=
TEMPLE_VAULT_ADDRESS=
BLESSING_DISTRIBUTOR_ADDRESS=
USDY_ADDRESS=

# ----- AI #1 Oracle — daily prophecy generation -----
# Reads chain + temple + civ state, writes 1-3 sentence cryptic prophecy.
ORACLE_API_KEY=
ORACLE_MODEL=google/gemini-2.5-flash

# ----- AI #1b Evaluator — fulfillment scoring -----
# Same Oracle persona, but scores yesterday's prophecy against today's reality.
# Can use a different (cheaper or stricter) model than generation.
EVALUATOR_API_KEY=
EVALUATOR_MODEL=google/gemini-2.5-flash

# ----- AI #3 Demiurge — divine tool selection -----
# Reads today's prophecy + civ snapshot, picks top-5 weighted tool candidates,
# posts a preview on-chain. Picks the actual tool 24h later and executes.
DEMIURGE_API_KEY=
DEMIURGE_MODEL=anthropic/claude-3-5-sonnet

# Legacy fallback — if any of the three *_API_KEY above are blank, this is used.
OPENROUTER_API_KEY=

# ----- Cycle tuning -----
FULFILLMENT_THRESHOLD=70
CRON_SCHEDULE=0 0 * * *
# Set DEMO_MODE=true to compress the 24h cadence to ~5 min for live demos.
DEMO_MODE=false

# ----- AI #2 Civilization Engine -----
# Pure deterministic simulation (no LLM). Maintains a 1024x1024 world state,
# ticks daily, posts snapshot hash to CivilizationLog.
CIV_LOG_ADDRESS=
CIV_ENGINE_PRIVATE_KEY=
CIV_STATE_FILE=./civ-state.json
DEMIURGE_STATE_FILE=./demiurge-state.json
