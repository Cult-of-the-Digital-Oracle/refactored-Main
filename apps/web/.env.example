# ============================================================================
# Frontend env — copy to `.env.local` and fill in.
# All addresses must match what `contracts/scripts/deploy.ts` printed on the
# target network. The `NEXT_PUBLIC_` prefix is required for client-side reads.
# ============================================================================

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Contract addresses on Mantle Sepolia (chainId 5003)
NEXT_PUBLIC_ORACLE_MESSAGE_ADDRESS=
NEXT_PUBLIC_TEMPLE_VAULT_ADDRESS=
NEXT_PUBLIC_BLESSING_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_USDY_ADDRESS=

# Oracle Civilization (the 3-AI feature on /oracle-world)
NEXT_PUBLIC_CIVILIZATION_LOG_ADDRESS=
